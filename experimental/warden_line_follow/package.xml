<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>warden_line_follow</name>
  <version>0.1.0</version>
  <description>Experimental real GPIO five-sensor line follower; requires bench calibration.</description>
  <maintainer email="maintainer@example.invalid">kiwi</maintainer>
  <license>LicenseRef-Proprietary</license>
  
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-lgpio</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>teleop_twist_joy</exec_depend>
  <exec_depend>joy</exec_depend>
  
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
