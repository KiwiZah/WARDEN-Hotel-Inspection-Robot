# Copy to a private environment file; do not commit secrets.
WARDEN_SERIAL_PORT=/dev/serial0
# Set 0.0.0.0 only on a trusted, firewalled lab network.
WARDEN_SERVER_HOST=127.0.0.1
WARDEN_ENABLE_LED=0
WARDEN_ENABLE_SPIN=0
# Optional. Without it, AI verification is unavailable and scans are inconclusive.
OPENAI_API_KEY=
