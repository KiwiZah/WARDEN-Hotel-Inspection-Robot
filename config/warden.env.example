# Copy to a private environment file; do not commit secrets.
WARDEN_SERIAL_PORT=/dev/serial0
# Set 0.0.0.0 only on a trusted, firewalled lab network.
WARDEN_SERVER_HOST=127.0.0.1
WARDEN_ENABLE_LED=0
WARDEN_ENABLE_SPIN=0
# Optional external image-based AI analysis. The default is OFF to protect room privacy.
# Only enable on consented test images. Requires a key and network connection.
WARDEN_ENABLE_AI=0
OPENAI_API_KEY=
